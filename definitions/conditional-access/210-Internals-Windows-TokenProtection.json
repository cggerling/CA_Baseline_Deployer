{
  "_deployer": {
    "key": "210-Internals-Windows-TokenProtection",
    "category": "Internals",
    "defaultSelected": true,
    "customerInput": [
      {
        "name": "AutopilotEnrollmentProfiles",
        "type": "stringList",
        "required": true,
        "render": "deviceFilterOrClause",
        "attribute": "device.enrollmentProfileName",
        "hint": "Namen deiner Autopilot-Enrollment-Profile. Geräte aus diesen Profilen werden von Token Protection ausgenommen, wie im Learn-Artikel beschrieben. Der Deployer hängt daraus \"-or (device.enrollmentProfileName -eq \"\"...\"\" -or ...)\" an den Gerätefilter an. Eine leere Liste muss bewusst bestätigt werden."
      }
    ]
  },
  "displayName": "#210-Internals-Windows-TokenProtection",
  "state": "enabledForReportingButNotEnforced",
  "grantControls": null,
  "partialEnablementStrategy": null,
  "conditions": {
    "userRiskLevels": [],
    "signInRiskLevels": [],
    "clientAppTypes": [
      "mobileAppsAndDesktopClients"
    ],
    "locations": null,
    "times": null,
    "deviceStates": null,
    "clientApplications": null,
    "agents": null,
    "actionsAndDestinations": null,
    "applications": {
      "includeApplications": [
        "9cdead84-a844-4324-93f2-b2e6bb768d07",
        "00000003-0000-0ff1-ce00-000000000000",
        "00000002-0000-0ff1-ce00-000000000000",
        "cc15fd57-2c6c-4117-a88c-83b1d56b4bbe",
        "0af06dc6-e4b5-4f28-818e-e78e62d137a5",
        "270efc09-cd0d-444b-a71f-39af4910ec45"
      ],
      "excludeApplications": [],
      "includeUserActions": [],
      "includeAgentActions": [],
      "includeAuthenticationContextClassReferences": [],
