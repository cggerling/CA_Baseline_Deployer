    "devices": {
      "includeDeviceStates": [],
      "excludeDeviceStates": [],
      "includeDevices": [],
      "excludeDevices": [],
      "deviceFilter": {
        "mode": "exclude",
        "rule": "(device.systemLabels -contains \"CloudPC\" -and device.trustType -eq \"AzureAD\")\n-or (device.systemLabels -contains \"AzureVirtualDesktop\" -and device.trustType -eq \"AzureAD\")\n-or (device.systemLabels -contains \"MicrosoftPowerAutomate\" -and device.trustType -eq \"AzureAD\")\n-or (device.profileType -eq \"SecureVM\" -and device.trustType -eq \"AzureAD\"){{input:AutopilotEnrollmentProfiles}}"
      }
    }
